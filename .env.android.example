# Android build environment (development only — never commit real URLs with secrets).
# The API URL is baked into the web bundle at BUILD time (Vite), so set it
# before running the production build that Capacitor packages.
#
# Local backend via Android emulator (emulator maps 10.0.2.2 -> host localhost):
# VITE_API_BASE_URL=http://10.0.2.2:8000
#
# Physical device on the same LAN (use your machine's LAN IP):
# VITE_API_BASE_URL=http://192.168.1.X:8000
#
# Production (HTTPS only — cleartext HTTP is blocked in release builds):
# VITE_API_BASE_URL=https://api.raksha.health
VITE_API_BASE_URL=http://10.0.2.2:8000
