# ============================================================
# RAKSHA backend — environment template
# Copy to .env and adjust. NEVER commit the real .env file.
# ============================================================

# --- Core ----------------------------------------------------
APP_NAME=RAKSHA API
ENVIRONMENT=development

# PostgreSQL (docker-compose service name is `db`; use db:5432 inside Docker,
# localhost:5432 only for local runs outside compose)
DATABASE_URL=postgresql+psycopg2://raksha:raksha@db:5432/raksha
# Local override example: postgresql+psycopg2://raksha:raksha@localhost:5432/raksha

# --- Auth ----------------------------------------------------
# Generate a strong secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
# REQUIRED in production (app refuses to boot with the default).
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Demo seed / synthetic training gates (never enable in production):
# RAKSHA_SEED_DEMO=false
# RAKSHA_TRAIN_SYNTHETIC=false

# --- CORS ----------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --- RAKSHA Patient ID ---------------------------------------
PATIENT_ID_PREFIX=RAK-PAT-2026

# --- Triage thresholds (rule-based decision support) ---------
TRIAGE_SPO2_CRITICAL=90
TRIAGE_SPO2_HIGH=93
TRIAGE_TEMP_HIGH=38.5
TRIAGE_TEMP_CRITICAL=39.5
TRIAGE_RR_HIGH=24
TRIAGE_HR_HIGH=120
TRIAGE_RULE_VERSION=respiratory-v1.2

# --- Integration placeholders (NOT configured in prototype) --
# SMS gateway — when unset, the dev-null provider is used and
# messages are only recorded in the outbox table.
SMS_PROVIDER=dev-null
SMS_API_KEY=
EMAIL_PROVIDER=dev-null
EMAIL_API_KEY=
# Firebase Cloud Messaging — in-app simulation until configured.
FCM_CREDENTIALS=
# ABDM / FHIR / eSanjeevani / HMIS adapters — integration ready.
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
FHIR_BASE_URL=
